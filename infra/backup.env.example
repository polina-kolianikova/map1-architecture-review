# Store the real file outside the repository with mode 0600.
# Use client-owned storage at a provider independent of the VPS provider.
BACKUP_S3_ENDPOINT_URL=<LOCAL_BACKUP_S3_ENDPOINT_URL>
BACKUP_S3_REGION=<LOCAL_BACKUP_S3_REGION>
BACKUP_S3_BUCKET=<LOCAL_BACKUP_S3_BUCKET>
BACKUP_S3_PREFIX=<LOCAL_BACKUP_S3_PREFIX>
BACKUP_S3_ACCESS_KEY_ID=<LOCAL_BACKUP_S3_ACCESS_KEY_ID>
BACKUP_S3_SECRET_ACCESS_KEY=<LOCAL_BACKUP_S3_SECRET_ACCESS_KEY>
# Generic S3 uses conditional publication of completion markers.
BACKUP_S3_PROVIDER=<LOCAL_BACKUP_S3_PROVIDER>
# Optional on generic S3; required with BACKUP_S3_PROVIDER=backblaze-b2.
# BACKUP_S3_OBJECT_LOCK_MODE=COMPLIANCE
