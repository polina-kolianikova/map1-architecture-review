# Install as /srv/map1/secrets/backup-job.env, owned by map1deploy, mode 0600.
BACKUP_S3_ENV_FILE=<LOCAL_BACKUP_S3_ENV_FILE>
BACKUP_SOURCE_ARCHIVE=<LOCAL_BACKUP_SOURCE_ARCHIVE>
BACKUP_SOURCE_MANIFEST=<LOCAL_BACKUP_SOURCE_MANIFEST>
BACKUP_JOB_ENV_FILE=<LOCAL_BACKUP_JOB_ENV_FILE>
# Set this when the deployment uses a Compose override.
# BACKUP_DEPLOY_OVERRIDE_FILE=/srv/map1/releases/REPLACE_RELEASE/deploy.override.json
# For the two Healthchecks jobs, include their limited ping URLs in encrypted recovery.
# This selects only the two known backup-alert-*.env files, not the whole directory.
# BACKUP_NOTIFICATION_ENV_DIR=/srv/map1/secrets
BACKUP_AGE_RECIPIENT=<LOCAL_BACKUP_AGE_RECIPIENT>
BACKUP_MIN_FREE_GB=<LOCAL_BACKUP_MIN_FREE_GB>
# Hard archive size cap. Raise only after measuring the rebuilt database.
BACKUP_MAX_DUMP_GB=<LOCAL_BACKUP_MAX_DUMP_GB>
# Email takes priority when a recipient is configured. Keep the actual recipient private.
# Use one plain mailbox per address; the sender MUST be verified with the SMTP relay.
# A client-provided SMTP relay and dedicated credentials are required (no personal mailbox password).
# Only authenticated TLS: port 465 uses SSL; port 587 requires STARTTLS. No plaintext fallback.
BACKUP_ALERT_EMAIL_TO=<LOCAL_BACKUP_ALERT_EMAIL_TO>
BACKUP_ALERT_EMAIL_FROM=<LOCAL_BACKUP_ALERT_EMAIL_FROM>
BACKUP_SMTP_HOST=<LOCAL_BACKUP_SMTP_HOST>
BACKUP_SMTP_PORT=<LOCAL_BACKUP_SMTP_PORT>
BACKUP_SMTP_USERNAME=<LOCAL_BACKUP_SMTP_USERNAME>
BACKUP_SMTP_PASSWORD=<LOCAL_BACKUP_SMTP_PASSWORD>
# Optional existing HTTPS webhook, also used if email configuration or delivery fails.
# Without a usable email relay or webhook, the notifier fails; journal entries are not delivery.
BACKUP_ALERT_WEBHOOK=<LOCAL_BACKUP_ALERT_WEBHOOK>
# Required for compose mounts in the scheduled checker and failure notifier.
BACKUP_BUNDLE_DIR=<LOCAL_BACKUP_BUNDLE_DIR>
BACKUP_RESTORE_DIR=<LOCAL_BACKUP_RESTORE_DIR>
BACKUP_UID=<LOCAL_BACKUP_UID>
BACKUP_GID=<LOCAL_BACKUP_GID>
# Optional: one additional project-owned configuration file to encrypt.
# BACKUP_EXTRA_CONFIG_FILE=/srv/map1/proxy/wireproxy.conf
